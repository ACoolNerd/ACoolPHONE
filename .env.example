# PostgreSQL
# Use a distinct production credential and require TLS in the managed service.
DATABASE_URL=postgresql://acoolphone:change-me@localhost:5432/acoolphone

# Public application metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ACoolPHONE

# Optional sales CTA. When unset, the site links to the ACoolNERD GitHub profile.
NEXT_PUBLIC_SALES_EMAIL=

# Foundation webhook receiver.
# Generate a minimum 32-byte value; store production values in a secret manager.
WEBHOOK_SIGNING_SECRET=replace-with-a-random-development-secret
